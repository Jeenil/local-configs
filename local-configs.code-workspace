{
  "folders": [
    {
      "path": ".",
    },
  ],

  "extensions": {
    "recommendations": [
      "DavidAnson.vscode-markdownlint", // Markdown linter
      "editorconfig.editorconfig", // Applies ".editorconfig"
      "esbenp.prettier-vscode", // General formatter
      "ms-python.black-formatter", // Python formatter
      "ms-python.python", // Python language server
      "ms-vscode.PowerShell", // PowerShell language server
      "timonwong.shellcheck", // Bash linter
    ],
  },

  "settings": {
    "editor.rulers": [100],
    "editor.tabSize": 2,

    // Always use "lf" to be consistent with all platforms.
    "files.eol": "\n",

    // Never write a BOM.
    "files.encoding": "utf8",
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,

    "[json]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.formatOnSave": true,
    },
    "[jsonc]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.formatOnSave": true,
    },
    "[markdown]": {
      "editor.codeActionsOnSave": {
        "source.fixAll.markdownlint": "explicit",
      },
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.formatOnSave": true,
    },
    "[yaml]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.formatOnSave": true,
    },
    "[shellscript]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.formatOnSave": true,
    },
    "[powershell]": {
      "editor.tabSize": 4,
    },
    "[python]": {
      "editor.defaultFormatter": "ms-python.black-formatter",
      "editor.formatOnSave": true,
      "editor.tabSize": 4,
    },
  },
}
